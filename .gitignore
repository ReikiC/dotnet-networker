## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ===========================================
# IDE 和编辑器生成的文件（最重要）
# ===========================================

# Visual Studio 用户特定文件
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/
# 如果您想保留某些 VS Code 配置，可以这样：
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json

# JetBrains Rider
.idea/
*.sln.iml

# ===========================================
# 操作系统生成的文件
# ===========================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS  
.DS_Store
.DS_Store?
._*

# Linux
*~

# ===========================================
# .NET 开发工具
# ===========================================

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# User-specific files
*.rsuser
*.userprefs

# ===========================================
# 配置和环境文件
# ===========================================

# 环境变量文件
.env
.env.local
.env.development.local
.env.production.local

# 本地配置文件
appsettings.local.json
appsettings.*.local.json
local.settings.json

# ===========================================
# 临时和缓存文件
# ===========================================

# 临时文件
*.tmp
*.temp
*.swp
*.swo
